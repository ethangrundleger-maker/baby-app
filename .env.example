# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SUMMARIZE=claude-sonnet-4-6

# --- Web Push (VAPID) ---
# Generate with: npm run generate-vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Family ---
# Shared invite code for the family account.
# Pick anything you like EXCEPT the literal value 'changeme' (the app refuses
# that to prevent accidental open access).
FAMILY_INVITE_CODE=set-a-real-code-here

# --- Timezone ---
NEXT_PUBLIC_TIMEZONE=America/New_York
